dup 103 /g put
dup 107 /k put
dup 108 /l put
dup 111 /o put
dup 49 /one put
dup 40 /parenleft put
dup 41 /parenright put
dup 43 /plus put
dup 115 /s put
dup 116 /t put
dup 126 /tilde put
dup 50 /two put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
